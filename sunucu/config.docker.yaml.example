# Docker/compose için config.yaml varyantı — bu dosya örnek/şablon'dur.
# Kurulumda `sunucu/docker-data/config/config.yaml` olarak kopyalayıp
# backend.api_key'i .env'deki BACKEND_API_KEY ile AYNI, kendi ürettiğiniz
# bir değerle değiştirin. Bu dosya ve yanındaki cameras.json imaja GÖMÜLMEZ —
# detector container'ına docker-compose.yml üzerinden dizin olarak
# bind-mount edilir (bkz. docker-compose.yml, PPE_CONFIG).
#
# Yerel (GPU'suz) test makinesi ile GPU sunucu arasındaki TEK fark:
#   model.device: "cpu"    (test makinesi, GPU yok)
#   model.device: "cuda:0" (GPU sunucu, docker-compose.gpu.yml ile)
# İmaj ikisinde de AYNI — cuda hiç çağrılmazsa NVIDIA driver gerekmez.
#
# cameras.json bu dosyayla AYNI dizinde olmalı (docker-data/config/cameras.json).
cameras_file: "cameras.json"

stream:
  read_fail_threshold: 30
  reconnect_backoff_initial_s: 1.0
  reconnect_backoff_max_s: 30.0
  idle_timeout_s: 20.0

capture:
  fps: 1.0
  continuous: true
  batch_size: 1                          # test makinesinde CPU ile düşük tutun; GPU sunucuda artırılabilir

monitoring:
  mode: "all"

server:
  host: "0.0.0.0"                        # container dışına (docker-compose "ports:") açmak için ZORUNLU
  port: 8090
  preview_width: 480
  preview_jpeg_quality: 70
  live_width: 1280
  live_jpeg_quality: 75
  live_fps: 10.0

model:
  path: "../detector/models/best.pt"     # config.yaml'a göre GÖRELİ; imajda WORKDIR /app/sunucu
  device: "cpu"                          # GPU sunucuda "cuda:0" yapın (docker-compose.gpu.yml ile)
  violation_class: "No-Helmet Head"
  thresholds:
    "No-Helmet Head": 0.35
    "Helmet": 0.30

sahi:
  slice_height: 768
  slice_width: 768
  overlap_ratio: 0.2
  postprocess_match_threshold: 0.5
  upscale_factor: 1.0
  enabled: true
  full_frame_pass: true

tracking:
  iou_threshold: 0.15
  max_age_seconds: 10.0
  confirm_frames: 1
  cooldown_seconds: 60
  match_distance_ratio: 1.5

logging:
  dir: "logs/ihlal"                      # imajda WORKDIR /app/sunucu'ya göreli; container'da
                                          # /app/sunucu/logs/ihlal'e karşılık gelir (bkz. docker-compose.yml)
  jsonl_name: "violations.jsonl"
  crop_padding_ratio: 0.4
  jpeg_quality: 90

backend:
  enabled: true
  url: "http://backend:8080"             # docker-compose servis adı (127.0.0.1 DEĞİL)
  api_key: "change-me-generate-32-hex"   # .env'deki BACKEND_API_KEY ile AYNI olmalı
  timeout_seconds: 5.0
  retry_interval_seconds: 30.0
